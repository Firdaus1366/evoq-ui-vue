{
  "name": "evoq-ui",
  "version": "0.0.1",
  "description": "Evoq design system components for Vue 3",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "docs/components",
    "mcp"
  ],
  "main": "./dist/evoq-ui.cjs",
  "module": "./dist/evoq-ui.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evoq-ui-mcp": "./mcp/server.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/evoq-ui.js",
      "require": "./dist/evoq-ui.cjs"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./style.css": "./dist/evoq-ui.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json",
    "./manifest.json": "./docs/components/manifest.json",
    "./docs/*": "./docs/components/*"
  },
  "scripts": {
    "dev": "node scripts/extract-props.mjs && vite",
    "build": "npm run typecheck && vite build && node scripts/bundle-fonts.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.build.json && vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify:figma": "node scripts/verify-figma.mjs",
    "build:playground": "node scripts/extract-props.mjs && vite build --config vite.playground.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,css,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,css,scss,json,md}\"",
    "prepublishOnly": "npm run build && npm run docs:check",
    "extract:props": "node scripts/extract-props.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "mcp": "node mcp/server.mjs",
    "build:fonts": "node scripts/bundle-fonts.mjs"
  },
  "peerDependencies": {
    "@unovis/ts": "^1.6.0",
    "@unovis/vue": "^1.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.103.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11",
    "vue": "3.5.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "component-library",
    "ui"
  ],
  "peerDependenciesMeta": {
    "@unovis/ts": {
      "optional": true
    },
    "@unovis/vue": {
      "optional": true
    }
  }
}
