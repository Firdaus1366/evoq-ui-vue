# Copy this file to `mcp/.env` to configure a local run of the evoq-ui MCP
# server (`npm run mcp` / `node mcp/server.mjs`). Every value here is also a
# plain environment variable a host process can set instead - those always
# win over `.env`.

# Host and port the Express/SSE server binds to.
PORT=4001
HOST=0.0.0.0

# Leave empty to run with no authentication - every /sse and /messages
# request is accepted. Set it to require callers to send it back as
# `x-api-key: <key>` (or, on GET /sse only, `?apiKey=<key>` for clients that
# cannot set a header on an SSE connection).
API_KEY=

# Optional. Overrides which docs/manifest.json this server reads. Almost
# never needed - it defaults to this package's own `docs/components`.
# DOCS_DIR=./docs/components
